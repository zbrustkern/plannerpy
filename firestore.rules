rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Ensure user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check for Google Auth Custom Claim 'admin'
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Ensure the document belongs to the authenticated user OR an admin
    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Plans Collection: Document must have a userId field matching the auth.uid
    match /plans/{planId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    // Wallets Collection: Document ID matches the auth.uid
    match /wallets/{userId} {
      allow read, write: if isOwner(userId);
    }

    // History Tracking Collection
    match /tracking_history/{docId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    // Admin Keys Collection: Strictly restricted to Admin role
    match /admin_keys/{keyId} {
      allow read, write: if isAdmin();
    }
  }
}